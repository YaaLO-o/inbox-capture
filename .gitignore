# Node / Electron
.worktrees/
node_modules/
npm-debug.log*

# macOS
.DS_Store

# Flutter / Dart 构建产物与缓存（app/.gitignore 也已包含，这里兜底）
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/pubspec.lock.bak
app/coverage/
app/.widget_preview/

# 发布产物（DMG 等），通过 GitHub Releases 分发，不提交进仓库
dist/

# IDE
*.iml
.idea/
.vscode/

# 本地采集产生的素材不应进入代码仓库（用户自己的 Obsidian 内容）
素材/
